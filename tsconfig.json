{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "@wdio/globals/types", "mocha"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@pages/*": ["src/pages/*"], "@support/*": ["src/support/*"] },
    "noEmit": true
  },
  "include": ["playwright.config.ts", "playwright.parabank.config.ts", "wdio.conf.ts", "src/**/*.ts", "tests/**/*.ts"]
}
