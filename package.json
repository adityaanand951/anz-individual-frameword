{
  "name": "acme-demo-automation",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Playwright and Appium automation scaffold for the Applitools ACME Demo App",
  "scripts": {
    "clean": "rimraf test-results playwright-report allure-results allure-report dist",
    "test": "npm run test:web",
    "test:web": "playwright test",
    "test:web:parallel:headed": "playwright test --headed --workers=6",
    "test:web:functional": "playwright test tests/web/functional",
    "test:web:visual": "playwright test tests/web/visual",
    "test:web:a11y": "playwright test tests/web/accessibility",
    "test:web:api": "playwright test tests/web/api",
    "test:web:api:parallel": "playwright test tests/web/api --workers=6",
    "test:parabank": "playwright test --config=playwright.parabank.config.ts",
    "test:parabank:smoke": "playwright test --config=playwright.parabank.config.ts --grep @smoke",
    "test:parabank:day-6": "playwright test --config=playwright.parabank.config.ts tests/parabank/day-6-transactions.spec.ts",
    "test:parabank:day-7": "playwright test --config=playwright.parabank.config.ts tests/parabank/day-7-lending.spec.ts",
    "test:parabank:parallel:headed": "node scripts/run-parabank-parallel-headed.cjs",
    "test:parabank:matrix": "node scripts/run-parabank-matrix.cjs",
    "test:parabank:android:headed:serial": "node scripts/run-parabank-android-headed-serial.cjs",
    "test:mobile": "wdio run wdio.conf.ts",
    "test:mobile:smoke": "wdio run wdio.conf.ts --spec tests/mobile/smoke.e2e.ts",
    "test:update-snapshots": "playwright test tests/web/visual --update-snapshots",
    "test:bdd": "cucumber-js --require-module ts-node/register --require tests/bdd/support/*.ts --require tests/bdd/steps/*.ts --format allure-cucumberjs/reporter --tags \"@web\" features",
    "test:bdd:api:parallel:headed": "node scripts/run-bdd-api-parallel-headed.cjs",
    "test:bdd:parabank": "cucumber-js --require-module ts-node/register --require tests/bdd/support/*.ts --require tests/bdd/steps/*.ts --format progress --tags \"@parabank\" features/parabank.feature",
    "report:parabank:inventory": "node scripts/generate-parabank-inventory.cjs",
    "test:bdd:mobile": "ts-node tests/bdd/mobile/run.ts",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.52.0",
    "@types/mocha": "^10.0.10",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.15.0",
    "@wdio/local-runner": "^9.15.0",
    "@wdio/mocha-framework": "^9.15.0",
    "@wdio/spec-reporter": "^9.15.0",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "webdriverio": "^9.15.0"
  }
}
